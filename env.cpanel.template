# cPanel Environment Variables Template
# Copy this to your cPanel Node.js App environment variables

# Application Configuration
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Database Configuration
DB_HOST=localhost
DB_USER=username_loan_user
DB_PASSWORD=your_secure_password_here
DB_NAME=username_loan_system

# Session Security
SESSION_SECRET=generate_a_strong_random_string_here_minimum_32_characters_long

# Password Hashing
BCRYPT_SALT_ROUNDS=10

# Instructions:
# 1. Replace all values with your actual values
# 2. PORT is auto-assigned by cPanel
# 3. Generate SESSION_SECRET: openssl rand -hex 32
# 4. Get DB credentials from cPanel MySQL Databases
# 5. Add these in cPanel Node.js App → Environment Variables


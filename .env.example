# Environment variables for Loan Update System on Vercel + Supabase

# Application Configuration
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Supabase Configuration
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key

# Session Security
SESSION_SECRET=generate_a_strong_random_string_here_minimum_32_characters_long

# Password Hashing
BCRYPT_SALT_ROUNDS=10